# PortOS 配置
#
# 复制为 .env 后按需修改：cp .env.example .env

# 网关和会话共用的 IANA 时区。留空时由启动脚本读取宿主机时区。
# PORTOS_TZ=Asia/Shanghai

# ------------------------------------------------------------------ 对外端口
# 宿主机绑定地址。0.0.0.0 允许局域网访问，仅限本机时填 127.0.0.1。
PORTOS_BIND=0.0.0.0

# 服务端在宿主机上发布的端口，浏览器通过这个端口访问 PortOS。
PORTOS_PORT=8081

# -------------------------------------------------------------- 会话与并发
# 服务端容器的内存上限。
SERVER_MEMORY=512m

# 同时在线的会话上限。每个会话约占 300-600MB 内存。
MAX_SESSIONS=4

# 会话的最长存活时间（秒）。到点后即使访客还在，服务端也会强制回收。
SESSION_TTL=3600

# 单个会话容器的内存上限。
SESSION_MEMORY=1200m

# 同时存在的会话容器总数上限（访客的 + 预热池的）。
# 设为 0 时，上限按 MAX_SESSIONS + max(0, WARM_POOL) + 2 计算。
MAX_CONTAINERS=0

# ------------------------------------------------------------------ 会话功能
# true 允许会话联网，false 将会话放到 Docker 内部网络。
SESSION_INTERNET=true

# true 开启声音，false 关闭音频支持。
SESSION_AUDIO=true

# 以远程会话为准：both（双向）、out（复制到本机）、in（从本机粘贴）、disabled（关闭）。
SESSION_CLIPBOARD=both

# 会话桌面壁纸，文件路径相对于 session/。
SESSION_WALLPAPER=PortOS-Wallpaper.png
# center（原尺寸居中）、fit（等比完整显示）、fill（等比铺满）、stretch（拉伸）、tile（平铺）。
SESSION_WALLPAPER_MODE=center

# ------------------------------------------------------------------ 预热池
# 每个程序提前准备几个「随时可用」的容器。访客点开时直接接管一个已经跑起来的
# 环境，首屏几乎立刻出现。访客离开后容器被销毁，并立即补上一个新的。
# 设为 0 关闭预热（每次都现场启动）。
WARM_POOL=1

# 预热容器被回收重建前的最长运行时间（秒）。
WARM_MAX_AGE=1800

# 预热池的巡检间隔（秒）。访客离开后，这个时间之内会补上新的容器。
WARM_INTERVAL=3

# 会话领出后无人连接，退回预热池或销毁前的宽限（秒）。
REQUEUE_GRACE=120

# 访客的连接断开后（关掉浏览器、关掉程序），过多少秒服务端就把会话销毁。
# 服务端自己就在 WebSocket 的中间，能立刻知道访客已经离开，所以这个值可以
# 比容器自己的心跳超时（RESET_GRACE）小很多，残留的容器不会占着名额。
STALE_GRACE=15

# 一个刚建好、还没启动的会话容器，允许被回收线程「冷落」多久（秒）。
# 建容器到启动之间这段时间里，容器不能被回收，否则启动会失败。
SETUP_GRACE=300

# ------------------------------------------------------------------ 分辨率
# 会话初始宽度（像素），浏览器上报的实际尺寸优先。
INIT_W=1280
# 会话初始高度（像素），浏览器上报的实际尺寸优先。
INIT_H=720

# ------------------------------------------------------------------ 窗口
# 程序窗口在远程桌面上的呈现方式：
#   natural    保持程序自己的尺寸并居中（只有超出屏幕时才会缩小）
#   fullscreen 铺满整个远程桌面
# apps/launch.ini 中的 Fullscreen 优先于此设置。
FIT_MODE=natural

# 远程桌面允许的最大宽度（像素）。
MAX_W=2560
# 远程桌面允许的最大高度（像素）。
MAX_H=1440

# ------------------------------------------------------------------ 生命周期
# 浏览器多久没有心跳（秒）之后判定访客已离开并销毁会话。
RESET_GRACE=120

# 会话领出后等待首位访客连接的时限（秒）。
BOOT_GRACE=180

# 访客说「再见」之后（关掉页面、关掉程序）多久（秒）才真正结束会话。
# 留一点余量，刷新页面时还能回到同一个会话。
BYE_GRACE=15

# 新建的会话容器多久（秒）之内没有报告「就绪」就放弃它。
READY_TIMEOUT=90

# 浏览器保留会话 Cookie 多久（秒）。到期后访客下次进来会拿到全新环境。
COOKIE_MAX_AGE=86400

# --------------------------------------------------------------- 镜像
# 服务端启动会话时使用的镜像名和标签。
SESSION_IMAGE=portos/session:latest

# ------------------------------------------------------------------ 调试
# 设为 1 会在服务端日志里打印每次转发的耗时（排查慢请求时用）。
PORTOS_TIMING=0
